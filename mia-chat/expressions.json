{
 "schemaVersion": 1,
 "status": "美亚表情集（用户提供）。分类由目视检查得出。",
 "assetRoot": "emojis/",
 "inspectionNote": "GIF 只看了静态帧，动画过程未逐帧确认。若某张的实际动态与 label 不符，改 label/usage 即可。",
 "selectionPolicy": {
  "ordinaryProbability": 0.6,
  "clearEmotionProbability": 1,
  "seriousExplanationProbability": 0,
  "afterStopTeasingProbability": 0,
  "maxImagesPerReply": 1,
  "minRepliesBetweenImages": 0,
  "minSecondsBetweenImages": 0,
  "excludeLastImageCount": 0,
  "historyScope": [
   "guildId",
   "channelId"
  ],
  "explicitImageRequest": "用户明确要某图时跳过随机；仍检查文件、语境和总请求限流；若表达不适则不发冲突图片。",
  "noMatch": "text_only",
  "priority": [
   "user_discomfort_or_stop_teasing",
   "explicit_image_request",
   "clear_emotion",
   "ordinary_chat"
  ],
  "notes": "美亚是纯聊天角色，没有「认真解释资料」的场景，so seriousExplanationProbability=0（引擎在 explanation 场景会额外要求图带 neutral/relaxed，这里直接不给）。爱心眼一族（phone/ecstatic/side）共用 variantGroup=heart_eyes，避免这类图占掉三成权重。未设配图冷却与去重，可连续配图、可重复。用户不适或要求停止调侃后 automatic 配图 0%（afterStopTeasingProbability=0），只有用户明确重新允许才恢复。"
 },
