 "selectionPolicy": {
  "ordinaryProbability": 0.6,
  "clearEmotionProbability": 1,
  "seriousExplanationProbability": 0,
  "afterStopTeasingProbability": 0,
  "maxImagesPerReply": 1,
  "minRepliesBetweenImages": 0,
  "minSecondsBetweenImages": 0,
  "excludeLastImageCount": 0,
  "historyScope": [
   "guildId",
   "channelId"
  ],
  "explicitImageRequest": "用户明确要某图时跳过随机；仍检查文件、语境和总请求限流；若表达不适则不发冲突图片。",
  "noMatch": "text_only",
  "priority": [
   "user_discomfort_or_stop_teasing",
   "explicit_image_request",
   "clear_emotion",
   "ordinary_chat"
  ],
  "notes": "美亚是纯聊天角色，没有「认真解释资料」的场景，so seriousExplanationProbability=0。近义图片按语义强度拆成 variantGroup；模型命中组内任意一个 ID 后，程序会补齐整组并等概率抽取，避免新增图永远得不到点名。未设配图冷却与去重，可连续配图、可重复。用户不适或要求停止调侃后 automatic 配图 0%，只有用户明确重新允许才恢复。"
 },
