<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="875"
        x:Class="TakaseBotDiscord.MainWindow"
        Title="Takase Bot · Discord 本地控制台"
        Width="940" Height="875" MinWidth="860" MinHeight="795"
        Background="#F7F8FB" FontFamily="Inter, PingFang SC, Microsoft YaHei UI, sans-serif">
  <Canvas>
    <!-- 标题 -->
    <TextBlock Text="Takase Bot" FontSize="32" FontWeight="Bold" Foreground="#151F33"
               Canvas.Left="28" Canvas.Top="18"/>
    <TextBlock Text="Discord 私人服务器多人分表版 · Gateway 长连接" FontSize="14" Foreground="#5E697D"
               Canvas.Left="31" Canvas.Top="64"/>

    <!-- 连接设置卡片 -->
    <Border Canvas.Left="24" Canvas.Top="96" Width="872" Height="316" Background="White"
            BorderBrush="#B7BECA" BorderThickness="1" CornerRadius="4">
      <Canvas>
        <TextBlock Text="连接设置" FontSize="14" FontWeight="Bold" Foreground="#232B3A"
                   Canvas.Left="18" Canvas.Top="14"/>
        <TextBlock Text="Application ID" FontSize="13" Foreground="#232B3A" Canvas.Left="18" Canvas.Top="59"/>
        <TextBox x:Name="txtApplicationId" FontSize="13" Canvas.Left="155" Canvas.Top="52" Width="685" Height="31"/>
        <TextBlock Text="Bot Token" FontSize="13" Foreground="#232B3A" Canvas.Left="18" Canvas.Top="106"/>
        <PasswordBox x:Name="txtBotToken" FontSize="13" Canvas.Left="155" Canvas.Top="99" Width="685" Height="31"/>
        <TextBlock Text="服务器 ID" FontSize="13" Foreground="#232B3A" Canvas.Left="18" Canvas.Top="153"/>
        <TextBox x:Name="txtGuildId" FontSize="13" Canvas.Left="155" Canvas.Top="146" Width="685" Height="31"/>
        <TextBlock Text="允许频道 ID" FontSize="13" Foreground="#232B3A" Canvas.Left="18" Canvas.Top="200"/>
        <TextBox x:Name="txtChannelIds" FontSize="13" Canvas.Left="155" Canvas.Top="193" Width="685" Height="31"/>
        <TextBlock Text="HTTP 代理（可选）" FontSize="13" Foreground="#232B3A" Canvas.Left="18" Canvas.Top="247"/>
        <TextBox x:Name="txtProxyUrl" FontSize="13" Canvas.Left="155" Canvas.Top="240" Width="685" Height="31"/>
        <CheckBox x:Name="chkReveal" Content="显示 Token" FontSize="12" Canvas.Left="747" Canvas.Top="106"/>
        <TextBlock Text="多个频道 ID 可用逗号或空格分隔；代理示例：http://127.0.0.1:7890" FontSize="12" Foreground="#646E7E"
                   Canvas.Left="155" Canvas.Top="279"/>
      </Canvas>
    </Border>

    <!-- 操作卡片 -->
    <Border Canvas.Left="24" Canvas.Top="428" Width="872" Height="132" Background="White"
            BorderBrush="#B7BECA" BorderThickness="1" CornerRadius="4">
      <Canvas>
        <Button x:Name="btnSave" Content="保存设置" FontSize="13" Canvas.Left="16" Canvas.Top="16" Width="132" Height="42"/>
        <Button x:Name="btnStart" Content="启动 Bot" FontSize="13" Canvas.Left="160" Canvas.Top="16" Width="132" Height="42"
                Background="#586EF2" Foreground="White"/>
        <Button x:Name="btnStop" Content="停止 Bot" FontSize="13" Canvas.Left="304" Canvas.Top="16" Width="132" Height="42"/>
        <Button x:Name="btnClearBindings" Content="清空全部用户绑定" FontSize="13" Canvas.Left="448" Canvas.Top="16" Width="170" Height="42"/>
        <CheckBox x:Name="chkAutoStart" Content="登录后自动启动" FontSize="12" Canvas.Left="632" Canvas.Top="28"/>
        <TextBlock x:Name="lblStatus" Text="状态：未启动" FontSize="13" FontWeight="Bold" Foreground="#6A7486"
                   Canvas.Left="18" Canvas.Top="76"/>
        <TextBlock x:Name="lblBindingCount" Text="已绑定用户：启动后读取" FontSize="13" Foreground="#6A7486"
                   Canvas.Left="280" Canvas.Top="76"/>
      </Canvas>
    </Border>

    <!-- 日志 -->
    <TextBlock Text="运行日志" FontSize="14" FontWeight="Bold" Foreground="#232B3A" Canvas.Left="28" Canvas.Top="576"/>
    <TextBox x:Name="txtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             FontFamily="Menlo, Consolas, monospace" FontSize="12"
             Background="#1B1F26" Foreground="#E6EBF2" BorderThickness="0"
             Canvas.Left="24" Canvas.Top="608" Width="872" Height="201"/>

    <!-- 底部提示 -->
    <TextBlock Text="Token 与群成员的大饼账号均只在本机钥匙串加密保存。首次使用请在 Discord 执行 /bind；不要把 Token、邮箱或密码发送到频道。"
               FontSize="12" Foreground="#626E7E" TextWrapping="Wrap" Canvas.Left="26" Canvas.Top="821" Width="872"/>
  </Canvas>
</Window>
